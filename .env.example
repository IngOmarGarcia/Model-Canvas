# ─────────────────────────────────────────────────────────────
# Inteligencia artificial (valores por defecto de la semilla)
# ─────────────────────────────────────────────────────────────
# La configuración real la guarda el facilitador en Configuración (tabla
# llm_settings de Neon). Estas variables solo siembran la fila inicial.
LLM_PROVIDER="ollama"
LLM_MODEL="llama3.1"
# Vacía con Ollama = la resuelve el entorno (ver abajo).
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MAX_OUTPUT_TOKENS="4000"

# ─────────────────────────────────────────────────────────────
# Ollama en desarrollo
# ─────────────────────────────────────────────────────────────
# Servidor de Ollama de esta máquina. Es el valor por defecto: solo hace falta
# declararlo si Ollama escucha en otro puerto o en otro equipo de la red.
OLLAMA_BASE_URL="http://localhost:11434"

# Fuerza el entorno cuando la detección automática no acierta: "local" | "hosted".
# Detección por defecto: NETLIFY (sin NETLIFY_DEV) o NODE_ENV=production ⇒ hosted.
# LLM_RUNTIME_ENV=""

# ─────────────────────────────────────────────────────────────
# Respaldo en la nube (SOLO producción: Netlify)
# ─────────────────────────────────────────────────────────────
# En Netlify no existe localhost, así que si la organización tiene Ollama con una
# URL local, el análisis se atiende con este proveedor. Si se deja sin definir, la
# aplicación muestra un mensaje claro en vez de fallar con un error de red.
#
# Groq, OpenRouter, Together, DeepInfra… exponen la API de OpenAI: con
# provider="openai" y su URL base sirve cualquiera de ellos.
# Ollama Cloud funciona con provider="ollama", base "https://ollama.com" y clave.
#
# Ejemplo con Groq (nivel gratuito):
# LLM_FALLBACK_PROVIDER="openai"
# LLM_FALLBACK_BASE_URL="https://api.groq.com/openai"
# LLM_FALLBACK_MODEL="llama-3.3-70b-versatile"
# LLM_FALLBACK_API_KEY="gsk_..."
# LLM_FALLBACK_LABEL="Groq · llama-3.3-70b"
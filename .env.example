# ─────────────────────────────────────────────────────────────
# Inteligencia artificial (valores por defecto de la semilla)
# ─────────────────────────────────────────────────────────────
# La configuración real la guarda el facilitador en Configuración (tabla
# llm_settings de Neon). Estas variables solo siembran la fila inicial.
LLM_PROVIDER="ollama"
LLM_MODEL="llama3.1"
# Vacía con Ollama = la resuelve el entorno (ver abajo).
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MAX_OUTPUT_TOKENS="4000"

# ─────────────────────────────────────────────────────────────
# Ollama en desarrollo
# ─────────────────────────────────────────────────────────────
# Servidor de Ollama de esta máquina. Es el valor por defecto: solo hace falta
# declararlo si Ollama escucha en otro puerto o en otro equipo de la red.
OLLAMA_BASE_URL="http://localhost:11434"

# Fuerza el entorno cuando la detección automática no acierta: "local" | "hosted".
# Detección por defecto: NETLIFY (sin NETLIFY_DEV) o NODE_ENV=production ⇒ hosted.
# LLM_RUNTIME_ENV=""

# ─────────────────────────────────────────────────────────────
# Respaldo en la nube: Google Gemini  ← configúralo en Netlify
# ─────────────────────────────────────────────────────────────
# En Netlify no existe localhost, así que el Ollama de tu máquina no es
# alcanzable. Con esta clave el análisis se atiende con Gemini (nivel gratuito de
# Google AI Studio: https://aistudio.google.com/apikey).
#
# También actúa en desarrollo: si Ollama está apagado o no tiene el modelo
# descargado, la petición se reintenta automáticamente con Gemini.
#
# Es lo ÚNICO obligatorio para que el análisis funcione en producción.
GEMINI_API_KEY=""

# Opcionales: por defecto gemini-2.0-flash contra la API oficial.
# GEMINI_MODEL="gemini-2.0-flash"
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com"

# ─────────────────────────────────────────────────────────────
# Respaldo alternativo (opcional, tiene prioridad sobre GEMINI_API_KEY)
# ─────────────────────────────────────────────────────────────
# Solo si prefieres otro proveedor. Groq, OpenRouter, Together, DeepInfra…
# exponen la API de OpenAI: con provider="openai" y su URL base sirve cualquiera.
# Ollama Cloud funciona con provider="ollama", base "https://ollama.com" y clave.
#
# Ejemplo con Groq (nivel gratuito):
# LLM_FALLBACK_PROVIDER="openai"
# LLM_FALLBACK_BASE_URL="https://api.groq.com/openai"
# LLM_FALLBACK_MODEL="llama-3.3-70b-versatile"
# LLM_FALLBACK_API_KEY="gsk_..."
# LLM_FALLBACK_LABEL="Groq · llama-3.3-70b"